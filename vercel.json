{
    "version": 2,
    "functions": {
        "backend/api/index.py": {
            "runtime": "python3.11"
        }
    },
    "routes": [
        {
            "src": "/api/v1/(.*)",
            "dest": "/backend/api/index.py"
        },
        {
            "handle": "filesystem"
        },
        {
            "src": "/(.*)",
            "dest": "/frontend/$1"
        }
    ]
}